// Mac Downloader – the secondary windows: Settings, Scheduler (queues), File
// Properties, Columns, Category properties, Find, Duplicate link, Shutdown
// countdown, Site Grabber / Download all links, Tip of the day, Refresh
// download address, torrents, playlists, browser setup, About and updates.
// Every window uses the shared design system in common.slint.

import { SpinBox, CheckBox, ListView, TextEdit, ScrollView, AboutSlint, Slider, Switch } from "std-widgets.slint";
import { Button, LineEdit, ComboBox, Cols, PairRow, LinkRow, QueueRow, DownloadRow, Theme, ThemedWindow, TypeIcon, KindTile, BigTypeIcon, BrandMark, HeaderCell, Cell, Glyph, Segment, SegmentedBar, Disclosure, Notice, FormSection, FormRow, FormStackRow, FieldRow, CheckMark, ListFrame, IconButton } from "common.slint";

// ------------------------------------------------------------------ small parts

component Label inherits Text {
    vertical-alignment: center;
    color: Theme.text;
    font-size: Theme.body-size;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: Theme.footnote-size;
    wrap: word-wrap;
}

// A dialog's title: an optional symbol tile, a title and a quiet subtitle.
component DialogHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    in property <string> glyph;
    in property <color> tint: Theme.accent;
    spacing: 14px;
    if root.kind != "": Rectangle {
        width: 46px;
        KindTile { kind: root.kind; y: (parent.height - self.height) / 2; width: 46px; height: 46px; }
    }
    if root.kind == "" && root.glyph != "": Rectangle {
        width: 46px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: root.tint;
            Glyph { x: 12px; y: 12px; width: 22px; height: 22px; kind: root.glyph; tint: Theme.on-accent; }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 19px * Theme.font-scale;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Theme.footnote-size;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
}

// a round option button (one of several)
component Radio inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    height: max(22px, lbl.preferred-height + 4px);
    min-width: lbl.preferred-width + 26px;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == " " || event.text == Key.Return)) { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    Rectangle {
        x: 0;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.muted.transparentize(0.3);
        background: root.checked ? Theme.accent : Theme.input-bg;
        opacity: root.enabled ? 1 : 0.5;
        if root.checked: Rectangle {
            x: 5px;
            y: 5px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.on-accent;
        }
        if focus.has-focus: Rectangle {
            x: -3px; y: -3px; width: 22px; height: 22px; border-radius: 11px;
            border-width: 2.5px; border-color: Theme.focus-ring;
        }
    }
    lbl := Text {
        x: 24px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: Theme.body-size;
        color: root.enabled ? Theme.text : Theme.muted;
        wrap: word-wrap;
    }
}

// a settings section in the sidebar, with a tinted symbol like System Settings
component SideTab inherits Rectangle {
    in property <string> text;
    in property <string> icon: "settings";
    in property <color> tint: #73737a;
    in property <bool> active;
    callback clicked();
    height: max(32px, label.preferred-height + 12px);
    border-radius: 9px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    forward-focus: keyboard;
    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
    background: root.active ? Theme.select : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => {
            keyboard.focus();
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 20px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 5px;
                background: root.tint;
                Glyph { x: 3px; y: 3px; width: 14px; height: 14px; kind: root.icon; tint: Theme.on-accent; }
            }
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.body-size;
            font-weight: root.active ? 600 : 400;
            color: Theme.text;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    if keyboard.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
}

// a small list with selection (logins, server exceptions, queue files)
component PairList inherits ListFrame {
    in property <[PairRow]> rows;
    in property <string> head-a;
    in property <string> head-b;
    in property <string> head-c;
    in property <length> width-b: 140px;
    in property <length> width-c: 0px;
    in property <string> empty-text;
    in-out property <int> current: -1;
    callback picked(int);
    accessible-role: list;
    accessible-label: root.head-a;
    VerticalLayout {
        padding: 1px;
        Rectangle {
            height: 26px;
            HorizontalLayout {
                padding-left: 6px;
                HeaderCell {
                    text: root.head-a;
                    horizontal-stretch: 1;
                }
                if root.head-b != "": HeaderCell {
                    text: root.head-b;
                    width: root.width-b;
                }
                if root.head-c != "": HeaderCell {
                    text: root.head-c;
                    width: root.width-c;
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.grid; }
        }
        ListView {
            vertical-stretch: 1;
            for r[i] in root.rows: Rectangle {
                height: 24px;
                background: i == root.current ? Theme.select : rt.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.fill : transparent;
                accessible-role: list-item;
                accessible-label: r.a;
                accessible-item-selected: i == root.current;
                accessible-action-default => { root.current = i; root.picked(i); }
                rt := TouchArea {
                    clicked => {
                        root.current = i;
                        root.picked(i);
                    }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    Cell {
                        text: r.a;
                        horizontal-stretch: 1;
                    }
                    if root.head-b != "": Cell {
                        text: r.b;
                        width: root.width-b;
                        color: Theme.muted;
                    }
                    if root.head-c != "": Cell {
                        text: r.c;
                        width: root.width-c;
                        color: Theme.muted;
                    }
                }
            }
        }
    }
    if root.rows.length == 0 && root.empty-text != "": Text {
        y: 26px;
        width: parent.width;
        height: parent.height - 26px;
        text: root.empty-text;
        color: Theme.muted;
        font-size: Theme.footnote-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The buttons along the bottom of a dialog: leading extras, then the
// trailing Cancel / default pair.
component ButtonRow inherits HorizontalLayout {
    spacing: 8px;
    alignment: end;
    @children
}

// ------------------------------------------------------------------ View > Columns

export component ColumnsDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Columns");
    preferred-width: 420px;
    in-out property <Cols> cols;
    callback save();
    callback reset();
    callback cancel();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        DialogHeader {
            title: @tr("Columns");
            subtitle: @tr("Show these columns in the download list:");
        }
        GridLayout {
            spacing-horizontal: 18px;
            spacing-vertical: 8px;
            Row {
                CheckBox { text: @tr("Q (queue number)"); checked: root.cols.q; toggled => { root.cols.q = self.checked; } }
                CheckBox { text: @tr("Size"); checked: root.cols.size; toggled => { root.cols.size = self.checked; } }
            }
            Row {
                CheckBox { text: @tr("Status"); checked: root.cols.status; toggled => { root.cols.status = self.checked; } }
                CheckBox { text: @tr("Time left"); checked: root.cols.eta; toggled => { root.cols.eta = self.checked; } }
            }
            Row {
                CheckBox { text: @tr("Transfer rate"); checked: root.cols.speed; toggled => { root.cols.speed = self.checked; } }
                CheckBox { text: @tr("Last Try Date"); checked: root.cols.last; toggled => { root.cols.last = self.checked; } }
            }
            Row {
                CheckBox { text: @tr("Description"); checked: root.cols.desc; toggled => { root.cols.desc = self.checked; } }
                CheckBox { text: @tr("Date Added"); checked: root.cols.added; toggled => { root.cols.added = self.checked; } }
            }
            Row {
                CheckBox { text: @tr("Save To"); checked: root.cols.saveto; toggled => { root.cols.saveto = self.checked; } }
                CheckBox { text: @tr("Referer"); checked: root.cols.referer; toggled => { root.cols.referer = self.checked; } }
            }
            Row {
                CheckBox { text: @tr("Parent Web Page"); checked: root.cols.parent; toggled => { root.cols.parent = self.checked; } }
            }
        }
        Hint { text: @tr("File Name (always shown)"); }
        HorizontalLayout {
            spacing: 8px;
            Button { text: @tr("Reset"); clicked => { root.reset(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            Button { text: @tr("OK"); primary: true; clicked => { root.save(); } }
        }
    }
}

// ------------------------------------------------------------------ category properties

export component CategoryDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.is-new ? @tr("Add category") : @tr("Category properties");
    preferred-width: 520px;
    in property <bool> is-new;
    in property <bool> builtin;
    in-out property <string> name;
    in-out property <string> exts;
    in-out property <string> sites;
    in-out property <string> folder;
    in property <string> message;
    callback browse();
    callback save();
    callback cancel();
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        DialogHeader {
            title: root.is-new ? @tr("Add category") : @tr("Category properties");
            subtitle: @tr("Files with these extensions, or from these sites, are put into this category and saved to its folder.");
            glyph: "folder";
        }
        FieldRow {
            label: @tr("Category name");
            LineEdit { text <=> root.name; enabled: !root.builtin; placeholder-text: @tr("e.g. Courses"); horizontal-stretch: 1; accessible-label: @tr("Category name"); }
        }
        FieldRow {
            label: @tr("File types");
            LineEdit { text <=> root.exts; placeholder-text: @tr("mp4 mkv avi (separated by spaces)"); horizontal-stretch: 1; accessible-label: @tr("File types"); }
        }
        FieldRow {
            label: @tr("Sites");
            LineEdit { text <=> root.sites; placeholder-text: @tr("udemy.com *.coursera.org (optional)"); horizontal-stretch: 1; accessible-label: @tr("Sites"); }
        }
        FieldRow {
            label: @tr("Save files to");
            LineEdit {
                text <=> root.folder;
                horizontal-stretch: 1;
                placeholder-text: Theme.native-macos ? @tr("automatic (Downloads/{})", root.name) : @tr("automatic (Downloads\\{})", root.name);
                accessible-label: @tr("Save files to");
            }
            Button { text: @tr("Choose…"); clicked => { root.browse(); } }
        }
        if root.message != "": Notice { text: root.message; tone: "error"; }
        ButtonRow {
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            Button { text: @tr("OK"); primary: true; clicked => { root.save(); } }
        }
    }
}

// ------------------------------------------------------------------ Find (Command-F)

export component FindDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Find file");
    preferred-width: 440px;
    in-out property <string> text;
    in-out property <bool> in-name: true;
    in-out property <bool> in-desc: true;
    in-out property <bool> in-address: false;
    in-out property <bool> match-case;
    in-out property <bool> whole;
    in property <string> message;
    callback find-next();
    callback close-window();
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        FieldRow {
            label: @tr("Find what");
            label-width: 80px;
            LineEdit {
                text <=> root.text;
                horizontal-stretch: 1;
                accessible-label: @tr("Find what");
                accepted(t) => {
                    root.find-next();
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                width: 80px * min(1.3, Theme.font-scale);
                text: @tr("Look in");
                horizontal-alignment: right;
                color: Theme.text;
            }
            VerticalLayout {
                spacing: 6px;
                CheckBox { text: @tr("File name"); checked <=> root.in-name; }
                CheckBox { text: @tr("Description"); checked <=> root.in-desc; }
                CheckBox { text: @tr("Address, referer and parent web page"); checked <=> root.in-address; }
                Rectangle { height: 4px; }
                CheckBox { text: @tr("Match case"); checked <=> root.match-case; }
                CheckBox { text: @tr("Match whole string"); checked <=> root.whole; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.message;
                color: Theme.muted;
                font-size: Theme.footnote-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button { text: @tr("Close"); clicked => { root.close-window(); } }
            Button { text: @tr("Find Next"); primary: true; clicked => { root.find-next(); } }
        }
    }
}

// ------------------------------------------------------------------ File properties

export component PropertiesDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("File Properties – {}", root.file-name);
    preferred-width: 580px;
    in property <string> file-name;
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> type-text;
    in property <string> status;
    in property <string> size;
    in property <string> added;
    in property <string> last-try;
    in property <string> result;
    in property <bool> done;
    in-out property <string> save-to;
    in-out property <string> url;
    in-out property <string> referer;
    in-out property <string> description;
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> message;
    callback browse();
    callback open-file();
    callback save();
    callback cancel();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 44px;
                KindTile { kind: root.kind; y: 0px; width: 44px; height: 44px; }
            }
            VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1;
                Text { text: root.file-name; font-size: Theme.title3-size; font-weight: 600; color: Theme.text; overflow: elide; }
                Text {
                    text: root.status + (root.size != "" ? "  ·  " + root.size : "");
                    font-size: Theme.footnote-size;
                    color: root.done ? Theme.ok : Theme.muted;
                    overflow: elide;
                }
            }
        }
        FormSection {
            FormRow { first: true; label: @tr("Type"); Text { text: root.type-text; color: Theme.muted; font-size: Theme.body-size; vertical-alignment: center; } }
            FormRow { label: @tr("Date added"); Text { text: root.added; color: Theme.muted; font-size: Theme.body-size; vertical-alignment: center; } }
            FormRow { label: @tr("Last try date"); Text { text: root.last-try; color: Theme.muted; font-size: Theme.body-size; vertical-alignment: center; } }
        }
        FieldRow {
            label: @tr("Save To");
            label-width: 96px;
            LineEdit { text <=> root.save-to; horizontal-stretch: 1; accessible-label: @tr("Save To"); }
            Button { text: @tr("Choose…"); clicked => { root.browse(); } }
        }
        FieldRow {
            label: @tr("Address");
            label-width: 96px;
            LineEdit { text <=> root.url; enabled: !root.done; horizontal-stretch: 1; accessible-label: @tr("Address"); }
        }
        FieldRow {
            label: @tr("Referer");
            label-width: 96px;
            LineEdit { text <=> root.referer; horizontal-stretch: 1; accessible-label: @tr("Referer"); }
        }
        FieldRow {
            label: @tr("Description");
            label-width: 96px;
            LineEdit { text <=> root.description; horizontal-stretch: 1; accessible-label: @tr("Description"); }
        }
        HorizontalLayout {
            padding-left: 96px * min(1.3, Theme.font-scale) + 10px;
            CheckBox { text: @tr("Use authorization (server login)"); checked <=> root.use-login; }
        }
        if root.use-login: FieldRow {
            label: @tr("Login");
            label-width: 96px;
            LineEdit { text <=> root.user; horizontal-stretch: 1; placeholder-text: @tr("Login"); accessible-label: @tr("Login"); }
            LineEdit { text <=> root.password; input-type: InputType.password; horizontal-stretch: 1; placeholder-text: @tr("Password"); accessible-label: @tr("Password"); }
        }
        if root.result != "": Notice { text: @tr("Result: {}", root.result); tone: root.done ? "ok" : "error"; }
        if root.message != "": Notice { text: root.message; tone: "error"; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: @tr("Open"); enabled: root.done; clicked => { root.open-file(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            Button { text: @tr("OK"); primary: true; clicked => { root.save(); } }
        }
    }
}

// ------------------------------------------------------------------ duplicate link

export component DuplicateDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Duplicate download link");
    preferred-width: 500px;
    in property <string> file-name;
    in property <string> existing-status;
    in-out property <int> choice: 1;
    in-out property <bool> remember;
    callback ok();
    callback cancel();
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        DialogHeader {
            title: @tr("This address is already in the download list:");
            subtitle: root.file-name + "  ·  " + root.existing-status;
            glyph: "copy";
        }
        VerticalLayout {
            spacing: 6px;
            padding-left: 52px;
            Radio { text: @tr("Add it with a new name (numbered)"); checked: root.choice == 1; clicked => { root.choice = 1; } }
            Radio { text: @tr("Add it and replace the old download (overwrite the file)"); checked: root.choice == 2; clicked => { root.choice = 2; } }
            Radio { text: @tr("If it is finished show it, if not resume it"); checked: root.choice == 3; clicked => { root.choice = 3; } }
            Rectangle { height: 4px; }
            CheckBox { text: @tr("Remember my choice (Options > Downloads)"); checked <=> root.remember; }
        }
        ButtonRow {
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
            Button { text: @tr("OK"); primary: true; clicked => { root.ok(); } }
        }
    }
}

// ------------------------------------------------------------------ shut down / sleep countdown

export component CountdownDialog inherits ThemedWindow {
    header-names-window: true;
    title: @tr("All downloads are finished.");
    preferred-width: 420px;
    always-on-top: true;
    // always in front already; kept so every window can be brought forward the same way
    in property <bool> front;
    in property <string> action-text: "shut down the computer";
    in property <int> seconds-left: 30;
    in property <int> seconds-total: 30;
    callback now();
    callback stop();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        DialogHeader {
            title: @tr("All downloads are finished.");
            subtitle: @tr("Mac Downloader will {} in {} seconds.", root.action-text, root.seconds-left);
            glyph: "clock";
            tint: Theme.warn;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.bar-bg;
            accessible-role: progress-indicator;
            accessible-value: root.seconds-left;
            accessible-value-minimum: 0;
            accessible-value-maximum: root.seconds-total;
            Rectangle {
                x: 0;
                height: parent.height;
                border-radius: 3px;
                width: parent.width * (root.seconds-total > 0 ? root.seconds-left / root.seconds-total : 0);
                background: Theme.warn;
                animate width { duration: Theme.reduce-motion ? 0ms : 900ms; }
            }
        }
        ButtonRow {
            Button { text: @tr("Now"); clicked => { root.now(); } }
            Button { text: @tr("Stop"); primary: true; clicked => { root.stop(); } }
        }
    }
}

// ------------------------------------------------------------------ Scheduler (queues)

export component SchedulerDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Scheduler");
    preferred-width: 780px;
    preferred-height: 540px;
    min-width: 640px;
    min-height: 440px;
    in property <[QueueRow]> queues;
    in-out property <int> current: 0;
    in-out property <int> tab: 0;
    in property <bool> is-main;
    in property <bool> running;
    // queue fields
    in-out property <string> name;
    in-out property <bool> start-enabled;
    in-out property <string> start-time;
    in-out property <bool> once;
    in-out property <string> once-date;
    in-out property <bool> d0;
    in-out property <bool> d1;
    in-out property <bool> d2;
    in-out property <bool> d3;
    in-out property <bool> d4;
    in-out property <bool> d5;
    in-out property <bool> d6;
    in-out property <bool> on-startup;
    in-out property <bool> stop-enabled;
    in-out property <string> stop-time;
    in-out property <int> parallel: 1;
    in-out property <int> retries;
    in-out property <string> folder;
    in-out property <int> when-done;
    in-out property <bool> open-when-done;
    in property <[PairRow]> files;
    in-out property <int> file-current: -1;
    in property <string> message;
    callback pick-queue(int);
    callback new-queue();
    callback delete-queue();
    callback browse();
    callback file-up();
    callback file-down();
    callback file-remove();
    callback start-now();
    callback stop-queue();
    callback apply();
    callback close-window();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 200px * min(1.25, Theme.font-scale);
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: @tr("Queues");
                    color: Theme.muted;
                    font-size: Theme.caption-size;
                    font-weight: 600;
                    height: 22px;
                    vertical-alignment: center;
                }
                ListView {
                    vertical-stretch: 1;
                    for q[i] in root.queues: Rectangle {
                        height: 28px;
                        border-radius: 6px;
                        background: i == root.current ? Theme.select : qa.has-hover ? Theme.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: q.name;
                        accessible-item-selected: i == root.current;
                        accessible-action-default => { root.pick-queue(i); }
                        qa := TouchArea {
                            clicked => {
                                root.pick-queue(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Rectangle {
                                width: 16px;
                                Glyph {
                                    y: (parent.height - self.height) / 2;
                                    kind: q.running ? "play" : "clock";
                                    tint: q.running ? Theme.ok : Theme.accent;
                                }
                            }
                            Cell { text: q.name; horizontal-stretch: 1; }
                            Cell { text: q.count > 0 ? q.count : ""; color: Theme.muted; font-size: Theme.footnote-size; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    IconButton { glyph: "plus"; label: @tr("New queue"); tooltip: false; clicked => { root.new-queue(); } }
                    IconButton { glyph: "minus"; label: @tr("Delete"); tooltip: false; enabled: !root.is-main; clicked => { root.delete-queue(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 20px;
            spacing: 14px;
            FieldRow {
                label: @tr("Queue name");
                label-width: 90px;
                LineEdit { text <=> root.name; horizontal-stretch: 1; accessible-label: @tr("Queue name"); }
            }
            SegmentedBar {
                Segment { text: @tr("Schedule"); active: root.tab == 0; clicked => { root.tab = 0; } }
                Segment { text: @tr("Files in the queue"); active: root.tab == 1; clicked => { root.tab = 1; } }
                Segment { text: @tr("Options"); active: root.tab == 2; clicked => { root.tab = 2; } }
            }
            if root.tab == 0: ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: schedule-body.preferred-height;
                schedule-body := VerticalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    alignment: start;
                    spacing: 14px;
                    padding-right: 6px;
                    FormSection {
                        FormRow {
                            first: true;
                            label: @tr("Start the queue automatically");
                            Switch { checked <=> root.start-enabled; accessible-label: @tr("Start the queue automatically"); }
                        }
                        FormRow {
                            label: @tr("Start time (HH:MM)");
                            enabled: root.start-enabled;
                            LineEdit { width: 90px; text <=> root.start-time; enabled: root.start-enabled; placeholder-text: "02:00"; accessible-label: @tr("Start time (HH:MM)"); }
                        }
                        FormStackRow {
                            enabled: root.start-enabled;
                            HorizontalLayout {
                                spacing: 16px;
                                Radio { text: @tr("Daily"); checked: !root.once; enabled: root.start-enabled; clicked => { root.once = false; } }
                                Radio { text: @tr("Once at (YYYY-MM-DD)"); checked: root.once; enabled: root.start-enabled; clicked => { root.once = true; } }
                                LineEdit { width: 120px; text <=> root.once-date; enabled: root.start-enabled && root.once; placeholder-text: "2026-12-31"; accessible-label: @tr("Once at (YYYY-MM-DD)"); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if !root.once: HorizontalLayout {
                                spacing: 6px;
                                CheckBox { text: @tr("Mon"); checked <=> root.d0; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Tue"); checked <=> root.d1; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Wed"); checked <=> root.d2; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Thu"); checked <=> root.d3; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Fri"); checked <=> root.d4; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Sat"); checked <=> root.d5; enabled: root.start-enabled; }
                                CheckBox { text: @tr("Sun"); checked <=> root.d6; enabled: root.start-enabled; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    FormSection {
                        FormRow {
                            first: true;
                            label: @tr("Start the queue when Mac Downloader starts");
                            Switch { checked <=> root.on-startup; accessible-label: @tr("Start the queue when Mac Downloader starts"); }
                        }
                        FormRow {
                            label: @tr("Stop the queue at");
                            Switch { checked <=> root.stop-enabled; accessible-label: @tr("Stop the queue at"); }
                            LineEdit { width: 90px; text <=> root.stop-time; enabled: root.stop-enabled; placeholder-text: "08:00"; accessible-label: @tr("Stop the queue at"); }
                        }
                        FormRow {
                            label: @tr("When the queue is done");
                            ComboBox {
                                model: [@tr("Do nothing"), @tr("Exit Mac Downloader"), @tr("Sleep"), @tr("Shut down the computer"), @tr("Hibernate")];
                                current-index <=> root.when-done;
                            }
                        }
                    }
                    if !Theme.native-macos: Hint {
                        text: @tr("For Sleep you may need to allow wake timers in the Windows power options, so the computer can wake up for the next start.");
                    }
                }
            }
            if root.tab == 1: VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;
                PairList {
                    vertical-stretch: 1;
                    rows: root.files;
                    current <=> root.file-current;
                    head-a: @tr("File name");
                    head-b: @tr("Size");
                    head-c: @tr("Status");
                    width-b: 90px;
                    width-c: 110px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: @tr("Move up"); enabled: root.file-current > 0; clicked => { root.file-up(); } }
                    Button { text: @tr("Move down"); enabled: root.file-current >= 0 && root.file-current < root.files.length - 1; clicked => { root.file-down(); } }
                    Button { text: @tr("Delete from queue"); enabled: root.file-current >= 0; clicked => { root.file-remove(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Hint {
                    text: @tr("Files download in this order. Add files with right click > Move to queue, Add Batch, or \"Download Later\".");
                }
            }
            if root.tab == 2: VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                spacing: 14px;
                FormSection {
                    FormRow {
                        first: true;
                        label: @tr("Files at the same time");
                        SpinBox { minimum: 1; maximum: 32; value <=> root.parallel; accessible-label: @tr("Files at the same time"); }
                    }
                    FormRow {
                        label: @tr("Number of retries for each file if downloading failed");
                        SpinBox { minimum: 0; maximum: 50; value <=> root.retries; accessible-label: @tr("Number of retries for each file if downloading failed"); }
                    }
                    FormRow {
                        label: @tr("Open each file when it has finished downloading");
                        Switch { checked <=> root.open-when-done; accessible-label: @tr("Open each file when it has finished downloading"); }
                    }
                    FormStackRow {
                        label: @tr("Save all files of this queue to");
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit { text <=> root.folder; placeholder-text: @tr("automatic (by file type)"); horizontal-stretch: 1; accessible-label: @tr("Save all files of this queue to"); }
                            Button { text: @tr("Choose…"); clicked => { root.browse(); } }
                        }
                    }
                }
            }
            if root.message != "": Notice { text: root.message; tone: "error"; }
            HorizontalLayout {
                spacing: 8px;
                if !root.running: Button { text: @tr("Start now"); clicked => { root.start-now(); } }
                if root.running: Button { text: @tr("Stop"); clicked => { root.stop-queue(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Close"); clicked => { root.close-window(); } }
                Button { text: @tr("Apply"); primary: true; clicked => { root.apply(); } }
            }
        }
    }
}

// ------------------------------------------------------------------ Site Grabber / Download all links

export component GrabberDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: root.links-mode ? @tr("Download all links") : @tr("Site Grabber");
    preferred-width: 860px;
    preferred-height: 600px;
    min-width: 680px;
    min-height: 460px;
    // true: links handed over by the browser (no exploring)
    in property <bool> links-mode;
    in-out property <string> start-url;
    in-out property <int> template: 0;
    in-out property <string> exts;
    in-out property <int> depth: 1;
    in-out property <bool> other-sites;
    in-out property <bool> no-parent: true;
    in-out property <int> parallel: 4;
    in property <bool> exploring;
    in property <string> progress-text;
    in property <[LinkRow]> links;
    in-out property <string> filter;
    in-out property <int> type-filter: 0;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main download queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in-out property <bool> use-text: true;
    in property <string> checked-text;
    in property <string> message;
    callback template-changed(int);
    callback explore();
    callback stop-explore();
    callback toggle(int);
    callback check-all(bool);
    callback filter-changed();
    callback browse();
    callback download();
    callback close-window();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        if !root.links-mode: VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.start-url;
                    placeholder-text: @tr("https://example.com/gallery/");
                    horizontal-stretch: 1;
                    accessible-label: @tr("Start page");
                }
                if !root.exploring: Button { text: @tr("Start exploring"); primary: true; enabled: root.start-url != ""; clicked => { root.explore(); } }
                if root.exploring: Button { text: @tr("Stop"); clicked => { root.stop-explore(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: @tr("Get"); }
                ComboBox {
                    width: 220px;
                    model: [@tr("All files (not web pages)"), @tr("All images"), @tr("All videos"), @tr("All music / audio"), @tr("Archives and programs"), @tr("Documents (PDF, Office)"), @tr("Custom file types")];
                    current-index <=> root.template;
                    selected(v) => {
                        root.template-changed(root.template);
                    }
                }
                if root.template == 6: LineEdit {
                    text <=> root.exts;
                    placeholder-text: @tr("jpg png mp4 (custom types)");
                    horizontal-stretch: 1;
                    accessible-label: @tr("Custom file types");
                }
                if root.template != 6: Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: @tr("Levels to explore"); }
                SpinBox { width: 80px; minimum: 0; maximum: 10; value <=> root.depth; }
                Rectangle { width: 6px; }
                Label { text: @tr("Pages at the same time"); }
                SpinBox { width: 80px; minimum: 1; maximum: 10; value <=> root.parallel; }
                Rectangle { width: 6px; }
                CheckBox { text: @tr("Other sites too"); checked <=> root.other-sites; }
                CheckBox { text: @tr("Don't go to parent folders"); checked <=> root.no-parent; }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.progress-text != "": Notice { text: root.progress-text; tone: root.exploring ? "busy" : "info"; }
        }
        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                width: 150px;
                model: [@tr("All types"), @tr("Images"), @tr("Videos"), @tr("Music"), @tr("Archives / programs"), @tr("Documents"), @tr("Web pages")];
                current-index <=> root.type-filter;
                selected(v) => {
                    root.filter-changed();
                }
            }
            LineEdit {
                text <=> root.filter;
                placeholder-text: @tr("Filter by name or address…");
                horizontal-stretch: 1;
                accessible-label: @tr("Filter by name or address…");
                edited(t) => {
                    root.filter-changed();
                }
            }
            Button { text: @tr("Check all"); clicked => { root.check-all(true); } }
            Button { text: @tr("Uncheck all"); clicked => { root.check-all(false); } }
        }
        ListFrame {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        HeaderCell { text: ""; width: 58px; }
                        HeaderCell { text: @tr("File name"); width: 250px; }
                        HeaderCell { text: @tr("Type"); width: 60px; }
                        HeaderCell { text: @tr("Link text"); width: 170px; }
                        HeaderCell { text: @tr("Address"); horizontal-stretch: 1; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.grid; }
                }
                ListView {
                    vertical-stretch: 1;
                    for l[i] in root.links: Rectangle {
                        height: 24px;
                        background: la.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.fill : transparent;
                        accessible-role: checkbox;
                        accessible-label: l.name;
                        accessible-checkable: true;
                        accessible-checked: l.checked;
                        accessible-action-default => { root.toggle(i); }
                        la := TouchArea {
                            clicked => {
                                root.toggle(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 6px;
                            Rectangle { width: 18px; CheckMark { y: (parent.height - self.height) / 2; checked: l.checked; } }
                            Rectangle { width: 18px; KindTile { kind: l.kind; y: (parent.height - self.height) / 2; width: 16px; height: 16px; } }
                            Cell { text: l.name; width: 246px; }
                            Cell { text: l.ext; width: 56px; color: Theme.muted; }
                            Cell { text: l.text; width: 166px; color: Theme.muted; }
                            Cell { text: l.url; horizontal-stretch: 1; color: Theme.muted; font-size: Theme.footnote-size; }
                        }
                    }
                }
            }
            if root.links.length == 0: Text {
                y: 26px;
                width: parent.width;
                height: parent.height - 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.links-mode ? @tr("No links on this page.") : root.exploring ? @tr("Exploring…") : @tr("Type a start page and click \"Start exploring\".");
                color: Theme.muted;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Label { text: @tr("Save to"); }
            LineEdit { text <=> root.folder; placeholder-text: @tr("automatic (by file type)"); horizontal-stretch: 1; accessible-label: @tr("Save to"); }
            Button { text: @tr("Choose…"); clicked => { root.browse(); } }
            Label { text: @tr("Queue"); }
            ComboBox { model: root.queue-names; current-index <=> root.queue-index; }
        }
        HorizontalLayout {
            spacing: 12px;
            CheckBox { text: @tr("Use link texts as descriptions"); checked <=> root.use-text; }
            CheckBox { text: @tr("Start the queue now"); checked <=> root.start-now; }
            Text {
                text: root.message != "" ? root.message : root.checked-text;
                color: root.message != "" ? Theme.err : Theme.muted;
                font-size: Theme.footnote-size;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                overflow: elide;
            }
            Button { text: @tr("Close"); clicked => { root.close-window(); } }
            Button { text: @tr("Download checked"); primary: true; clicked => { root.download(); } }
        }
    }
}

// ------------------------------------------------------------------ Tip of the day

export component TipDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Tip of the day");
    // a set size: a wrapped text that decides the window's size can make the
    // window measure itself again and again
    preferred-width: 480px;
    preferred-height: 220px;
    min-width: 420px;
    min-height: 200px;
    in property <string> tip;
    in property <string> counter;
    in-out property <bool> show-on-start: true;
    callback next();
    callback close-window();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            Rectangle {
                width: 40px;
                Rectangle {
                    y: 0px;
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: #b7861a;
                    Glyph { x: 10px; y: 10px; width: 20px; height: 20px; kind: "bulb"; tint: Theme.on-accent; }
                }
            }
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: @tr("Did you know…");
                    font-size: Theme.title3-size;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: root.tip;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: Theme.body-size;
                    vertical-stretch: 1;
                }
                Text {
                    text: root.counter;
                    color: Theme.muted;
                    font-size: Theme.footnote-size;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox { text: @tr("Show tips at startup"); checked <=> root.show-on-start; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Next tip"); clicked => { root.next(); } }
            Button { text: @tr("Close"); primary: true; clicked => { root.close-window(); } }
        }
    }
}

// ------------------------------------------------------------------ Refresh download address

export component RefreshDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Refresh download address");
    preferred-width: 520px;
    in property <string> file-name;
    in property <string> page;
    in property <bool> waiting: true;
    in-out property <string> new-url;
    callback open-page();
    callback use-url();
    callback stop-waiting();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        DialogHeader {
            title: @tr("Refresh download address");
            subtitle: root.file-name;
            glyph: "refresh";
        }
        Text {
            text: @tr("1. Open the web page where you got this file.\n2. Click the download link there again (or start the video).\n3. Mac Downloader takes the new address and continues from where it stopped.");
            wrap: word-wrap;
            color: Theme.text;
            font-size: Theme.body-size;
        }
        if root.page != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.page;
                color: Theme.muted;
                font-size: Theme.footnote-size;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button { text: @tr("Open the page"); clicked => { root.open-page(); } }
        }
        if root.waiting: Notice { text: @tr("Waiting for the new address from the browser…"); tone: "busy"; }
        VerticalLayout {
            spacing: 6px;
            Label { text: @tr("Or paste the new address here:"); }
            HorizontalLayout {
                spacing: 6px;
                LineEdit { text <=> root.new-url; horizontal-stretch: 1; placeholder-text: @tr("https://…"); accessible-label: @tr("Or paste the new address here:"); }
                Button { text: @tr("Use it"); enabled: root.new-url != ""; clicked => { root.use-url(); } }
            }
        }
        ButtonRow {
            Button { text: @tr("Stop waiting"); clicked => { root.stop-waiting(); } }
        }
    }
}

// ------------------------------------------------------------------ Settings

component SoundRow inherits FormStackRow {
    in-out property <string> path;
    callback browse();
    callback play();
    HorizontalLayout {
        spacing: 6px;
        LineEdit { text <=> root.path; horizontal-stretch: 1; placeholder-text: @tr("No sound"); accessible-label: root.label; }
        Button { text: @tr("Choose…"); clicked => { root.browse(); } }
        Button { text: @tr("Play"); enabled: root.path != ""; clicked => { root.play(); } }
    }
}

export component SettingsDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Settings");
    preferred-width: 780px;
    preferred-height: 580px;
    min-width: 640px;
    min-height: 440px;

    in-out property <int> tab: 0;
    // General
    in-out property <int> language;
    in-out property <int> theme;
    // how solid the main window is, 50..100 %
    in-out property <float> window-opacity: 100;
    // called while the slider moves, so the window shows it at once
    callback preview-opacity(float);
    // text size (percent) and font of every window
    in-out property <float> text-size: 100;
    in-out property <int> font-index;
    // a picture behind the main window instead of the theme's color
    in-out property <string> bg-image;
    in-out property <float> bg-strength: 45;
    callback browse-bg();
    // the look changed: show it at once (the settings are kept on OK)
    callback preview-look();
    in property <string> startup-label: @tr("Launch Mac Downloader on Windows startup");
    in property <bool> windows-features: true;
    in property <bool> background-supported: false;
    in property <string> background-label: @tr("Keep running next to the clock when the window is closed");
    in-out property <bool> start-with-windows;
    in-out property <bool> close-to-tray;
    in-out property <bool> clipboard;
    in-out property <bool> auto-clipboard;
    in-out property <int> double-click;
    in-out property <bool> show-tips;
    in-out property <int> port;
    in-out property <int> skip-key;
    in-out property <int> force-key;
    in property <string> extension-path;
    // File types
    in-out property <string> capture-exts;
    in-out property <string> skip-sites;
    in-out property <string> skip-addresses;
    in-out property <bool> panel-enabled;
    in-out property <string> panel-skip-sites;
    in-out property <int> panel-min-video;
    in-out property <int> panel-min-audio;
    // Save To
    in-out property <string> download-dir;
    in-out property <bool> category-folders;
    in-out property <string> temp-dir;
    // Downloads
    in-out property <bool> show-start-dialog;
    in-out property <bool> start-while-info;
    in-out property <bool> complete-dialog;
    in-out property <int> progress-mode;
    in-out property <int> duplicate-action;
    in-out property <bool> set-file-date;
    in-out property <bool> virus-scan;
    in-out property <string> virus-program;
    in-out property <string> virus-args;
    in-out property <string> user-agent;
    // Connection
    in-out property <int> connection-type;
    in-out property <int> connections;
    in-out property <int> max-active;
    in-out property <int> retries;
    in property <[PairRow]> server-rows;
    in-out property <int> server-current: -1;
    in-out property <string> server-host;
    in-out property <int> server-conns: 2;
    in-out property <bool> quota-on;
    in-out property <int> quota-mb;
    in-out property <int> quota-hours;
    in property <string> quota-used;
    // Proxy
    in-out property <int> proxy-mode;
    in-out property <string> proxy-host;
    in-out property <int> proxy-port;
    in-out property <string> proxy-user;
    in-out property <string> proxy-password;
    in-out property <string> proxy-bypass;
    // Site logins
    in property <[PairRow]> login-rows;
    in-out property <int> login-current: -1;
    in-out property <string> login-site;
    in-out property <string> login-user;
    in-out property <string> login-password;
    // Sounds
    in-out property <bool> sounds-on;
    in-out property <string> sound-complete;
    in-out property <string> sound-failed;
    in-out property <string> sound-qstart;
    in-out property <string> sound-qdone;
    // Speed limiter
    in-out property <bool> limiter-on;
    in-out property <int> speed-limit;
    in-out property <bool> limiter-startup;
    // Torrents tab
    in-out property <int> seed-minutes;
    in-out property <int> torrent-upload;
    in property <string> message;

    callback browse(string);
    callback play(string);
    callback reset-paths();
    callback default-exts();
    callback server-add();
    callback server-remove();
    callback login-add();
    callback login-remove();
    callback login-pick(int);
    callback open-extension-folder();
    callback save();
    callback cancel();

    // The sidebar order groups everyday settings first; `index` is the
    // stable pane number used by the app (Appearance… opens 9).
    property <[{index: int, title: string, icon: string, tint: color}]> panes: [
        { index: 0, title: @tr("General"), icon: "settings", tint: #73737a },
        { index: 9, title: @tr("Appearance"), icon: "appearance", tint: #3d3d42 },
        { index: 3, title: @tr("Downloads"), icon: "down", tint: #2f6bd0 },
        { index: 2, title: @tr("Save To"), icon: "folder", tint: #3e88d8 },
        { index: 1, title: @tr("File Types"), icon: "puzzle", tint: #c25d0c },
        { index: 4, title: @tr("Connection"), icon: "signal", tint: #2c8343 },
        { index: 5, title: @tr("Proxy / Server"), icon: "server", tint: #5d6b7b },
        { index: 6, title: @tr("Site Logins"), icon: "lock", tint: #6d53b5 },
        { index: 8, title: @tr("Speed Limiter"), icon: "gauge", tint: #c03a44 },
        { index: 7, title: @tr("Sounds"), icon: "speaker", tint: #b13a69 },
        { index: 10, title: @tr("Torrents"), icon: "torrent", tint: #11786c },
    ];
    pure function pane-title(i: int) -> string {
        if (i == 0) { return @tr("General"); }
        if (i == 1) { return @tr("File Types"); }
        if (i == 2) { return @tr("Save To"); }
        if (i == 3) { return @tr("Downloads"); }
        if (i == 4) { return @tr("Connection"); }
        if (i == 5) { return @tr("Proxy / Server"); }
        if (i == 6) { return @tr("Site Logins"); }
        if (i == 7) { return @tr("Sounds"); }
        if (i == 8) { return @tr("Speed Limiter"); }
        if (i == 9) { return @tr("Appearance"); }
        return @tr("Torrents");
    }
    property <[string]> modifier-keys: Theme.native-macos ? [@tr("Option"), @tr("Control"), @tr("Shift"), @tr("None")] : [@tr("Alt"), @tr("Ctrl"), @tr("Shift"), @tr("None")];

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            reject
        }
    HorizontalLayout {
        spacing: 0px;
        padding-left: 8px;
        padding-bottom: 8px;
        padding-top: 2px;
        Rectangle {
            width: 204px * min(1.25, Theme.font-scale);
            background: Theme.sidebar;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.control-border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Theme.shadow.transparentize(0.45);
            accessible-role: tab-list;
            accessible-label: @tr("Settings");
            VerticalLayout {
                padding: 10px;
                spacing: 1px;
                alignment: start;
                for p in root.panes: SideTab {
                    text: p.title;
                    icon: p.icon;
                    tint: p.tint;
                    active: root.tab == p.index;
                    clicked => { root.tab = p.index; }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            pane := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                accessible-role: tab-panel;
                body := VerticalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    alignment: start;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 18px;
                    padding-bottom: 20px;
                    spacing: 18px;
                    Text {
                        text: root.pane-title(root.tab);
                        font-size: Theme.title2-size;
                        font-weight: 700;
                        color: Theme.text;
                    }

                    // ---------------- General
                    if root.tab == 0: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("Language");
                                ComboBox {
                                    width: 170px;
                                    model: ["English", "العربية", "Français", "Español", "Deutsch", "Português", "Türkçe", "Русский"];
                                    current-index <=> root.language;
                                }
                            }
                            FormRow {
                                label: root.startup-label;
                                Switch { checked <=> root.start-with-windows; accessible-label: root.startup-label; }
                            }
                            FormRow {
                                label: root.background-label;
                                enabled: root.background-supported;
                                Switch { enabled: root.background-supported; checked <=> root.close-to-tray; accessible-label: root.background-label; }
                            }
                        }
                        FormSection {
                            title: @tr("Clipboard");
                            FormRow {
                                first: true;
                                label: @tr("Watch the clipboard for download links");
                                Switch { checked <=> root.clipboard; accessible-label: @tr("Watch the clipboard for download links"); }
                            }
                            FormRow {
                                label: @tr("Automatically start downloading links placed in the clipboard");
                                enabled: root.clipboard;
                                Switch { checked <=> root.auto-clipboard; enabled: root.clipboard; accessible-label: @tr("Automatically start downloading links placed in the clipboard"); }
                            }
                        }
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("On double click on a download");
                                ComboBox {
                                    width: 230px;
                                    model: [@tr("Open the file / progress window"), @tr("Show properties")];
                                    current-index <=> root.double-click;
                                }
                            }
                            FormRow {
                                label: @tr("Show \"Tip of the day\" at startup");
                                Switch { checked <=> root.show-tips; accessible-label: @tr("Show \"Tip of the day\" at startup"); }
                            }
                        }
                        FormSection {
                            title: @tr("Browser integration");
                            FormRow {
                                first: true;
                                label: @tr("Browser Extension Setup");
                                hint: @tr("Use the setup assistant to connect your browser. It prepares the extension, opens the right page, and checks the connection.");
                                Button { text: @tr("Set Up…"); clicked => { root.open-extension-folder(); } }
                            }
                            FormRow {
                                label: @tr("Hold this key to let the browser download by itself");
                                ComboBox { width: 110px; model: root.modifier-keys; current-index <=> root.skip-key; }
                            }
                            FormRow {
                                label: @tr("Hold this key to force Mac Downloader to take a link");
                                ComboBox { width: 110px; model: root.modifier-keys; current-index <=> root.force-key; }
                            }
                            FormRow {
                                label: @tr("Browser extension port");
                                SpinBox { width: 110px; minimum: 1024; maximum: 65535; value <=> root.port; accessible-label: @tr("Browser extension port"); }
                            }
                        }
                    }

                    // ---------------- Appearance
                    if root.tab == 9: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            footer: @tr("System follows your Mac's Light or Dark appearance automatically.");
                            FormRow {
                                first: true;
                                label: @tr("Appearance");
                                ComboBox {
                                    width: 170px;
                                    model: [@tr("System"), @tr("Light"), @tr("Dark")];
                                    current-index <=> root.theme;
                                    selected(value) => { root.preview-look(); }
                                }
                            }
                            FormRow {
                                label: @tr("Text size");
                                Slider {
                                    width: 170px;
                                    minimum: 80;
                                    maximum: 150;
                                    value <=> root.text-size;
                                    accessible-label: @tr("Text size");
                                    changed(v) => { root.preview-look(); }
                                }
                                Text { min-width: 40px; text: Math.round(root.text-size) + "%"; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; }
                            }
                            FormRow {
                                label: @tr("Font");
                                ComboBox {
                                    width: 170px;
                                    model: [@tr("System Font"), "Tahoma", "Arial", "Calibri", "Verdana", "Times New Roman", "Courier New"];
                                    current-index <=> root.font-index;
                                    selected => { root.preview-look(); }
                                }
                            }
                            if root.windows-features: FormRow {
                                label: @tr("Window opacity");
                                Slider {
                                    width: 170px;
                                    minimum: 50;
                                    maximum: 100;
                                    value <=> root.window-opacity;
                                    accessible-label: @tr("Window opacity");
                                    changed(v) => { root.preview-opacity(v); }
                                }
                                Text { min-width: 40px; text: Math.round(root.window-opacity) + "%"; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                        FormSection {
                            title: @tr("Background picture");
                            FormRow {
                                first: true;
                                label: root.bg-image != "" ? root.bg-image : @tr("none (the theme's colors)");
                                Button { text: @tr("Choose…"); clicked => { root.browse-bg(); } }
                                Button {
                                    text: @tr("Remove");
                                    enabled: root.bg-image != "";
                                    clicked => {
                                        root.bg-image = "";
                                        root.preview-look();
                                    }
                                }
                            }
                            if root.bg-image != "": FormRow {
                                label: @tr("Picture visibility");
                                Slider {
                                    width: 170px;
                                    minimum: 10;
                                    maximum: 80;
                                    value <=> root.bg-strength;
                                    accessible-label: @tr("Picture visibility");
                                    changed(v) => { root.preview-look(); }
                                }
                                Text { min-width: 40px; text: Math.round(root.bg-strength) + "%"; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                    }

                    // ---------------- File Types (what the browser hands over)
                    if root.tab == 1: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            title: @tr("Browser downloads");
                            FormStackRow {
                                first: true;
                                label: @tr("Automatically start downloading these file types (from the browser):");
                                TextEdit {
                                    text <=> root.capture-exts;
                                    min-height: 76px;
                                    font-size: Theme.body-size;
                                    wrap: word-wrap;
                                    accessible-label: @tr("Automatically start downloading these file types (from the browser):");
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    Button { text: @tr("Default"); clicked => { root.default-exts(); } }
                                }
                            }
                            FormStackRow {
                                label: @tr("Don't start downloading automatically from these sites:");
                                LineEdit {
                                    text <=> root.skip-sites;
                                    placeholder-text: Theme.native-macos ? "example.com  *.example.org" : @tr("*.update.microsoft.com  windowsupdate.com");
                                    accessible-label: @tr("Don't start downloading automatically from these sites:");
                                }
                            }
                            FormStackRow {
                                label: @tr("Don't start downloading these addresses (one per line, * allowed):");
                                TextEdit {
                                    text <=> root.skip-addresses;
                                    min-height: 58px;
                                    font-size: Theme.body-size;
                                    accessible-label: @tr("Don't start downloading these addresses (one per line, * allowed):");
                                }
                            }
                        }
                        FormSection {
                            title: @tr("Video button");
                            FormRow {
                                first: true;
                                label: @tr("Show the \"Download this video\" panel on web players");
                                Switch { checked <=> root.panel-enabled; accessible-label: @tr("Show the \"Download this video\" panel on web players"); }
                            }
                            FormStackRow {
                                label: @tr("Don't show it on these sites");
                                enabled: root.panel-enabled;
                                LineEdit { text <=> root.panel-skip-sites; enabled: root.panel-enabled; accessible-label: @tr("Don't show it on these sites"); }
                            }
                            FormRow {
                                label: @tr("Smallest video (KB)");
                                enabled: root.panel-enabled;
                                SpinBox { width: 110px; minimum: 0; maximum: 100000; value <=> root.panel-min-video; enabled: root.panel-enabled; accessible-label: @tr("Smallest video (KB)"); }
                            }
                            FormRow {
                                label: @tr("Smallest audio (KB)");
                                enabled: root.panel-enabled;
                                SpinBox { width: 110px; minimum: 0; maximum: 100000; value <=> root.panel-min-audio; enabled: root.panel-enabled; accessible-label: @tr("Smallest audio (KB)"); }
                            }
                        }
                    }

                    // ---------------- Save To
                    if root.tab == 2: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            FormStackRow {
                                first: true;
                                label: @tr("Main download folder");
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.download-dir; horizontal-stretch: 1; accessible-label: @tr("Main download folder"); }
                                    Button { text: @tr("Choose…"); clicked => { root.browse("download"); } }
                                }
                            }
                            FormRow {
                                label: @tr("Sort files into folders by category (Video, Music, Programs, Compressed, Documents, Images…)");
                                hint: @tr("Each category's own folder and file types: right click it in the sidebar > Properties.");
                                Switch { checked <=> root.category-folders; accessible-label: @tr("Sort files into folders by category (Video, Music, Programs, Compressed, Documents, Images…)"); }
                            }
                            FormRow {
                                label: @tr("Remembered category paths");
                                Button { text: @tr("Forget remembered category paths"); clicked => { root.reset-paths(); } }
                            }
                        }
                        FormSection {
                            footer: @tr("Tip: a temporary folder on another drive than the download folder makes joining the parts faster.");
                            FormStackRow {
                                first: true;
                                label: @tr("Temporary folder (parts while downloading)");
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.temp-dir; placeholder-text: @tr("next to the file (default)"); horizontal-stretch: 1; accessible-label: @tr("Temporary folder (parts while downloading)"); }
                                    Button { text: @tr("Choose…"); clicked => { root.browse("temp"); } }
                                }
                            }
                        }
                    }

                    // ---------------- Downloads
                    if root.tab == 3: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("Show the \"Download File Info\" window for downloads from the browser");
                                Switch { checked <=> root.show-start-dialog; accessible-label: @tr("Show the \"Download File Info\" window for downloads from the browser"); }
                            }
                            FormRow {
                                label: @tr("Start downloading immediately while showing \"Download File Info\"");
                                Switch { checked <=> root.start-while-info; accessible-label: @tr("Start downloading immediately while showing \"Download File Info\""); }
                            }
                            FormRow {
                                label: @tr("Show the \"Download complete\" window");
                                Switch { checked <=> root.complete-dialog; accessible-label: @tr("Show the \"Download complete\" window"); }
                            }
                            FormRow {
                                label: @tr("Background progress window");
                                ComboBox {
                                    width: 220px;
                                    model: [@tr("When Downloads Is Hidden"), @tr("Minimized"), @tr("Don't Show")];
                                    current-index <=> root.progress-mode;
                                }
                            }
                        }
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("If a duplicate link is added");
                                ComboBox {
                                    width: 260px;
                                    model: [@tr("Ask me"), @tr("Add it with a numbered file name"), @tr("Add it and replace the old download"), @tr("Show the finished one / resume the unfinished one")];
                                    current-index <=> root.duplicate-action;
                                }
                            }
                            FormRow {
                                label: @tr("Give finished files the date from the server");
                                Switch { checked <=> root.set-file-date; accessible-label: @tr("Give finished files the date from the server"); }
                            }
                        }
                        FormSection {
                            title: @tr("Malware check");
                            footer: @tr("[File] is replaced by the downloaded file.");
                            FormRow {
                                first: true;
                                label: @tr("Check every finished file for viruses with this program");
                                Switch { checked <=> root.virus-scan; accessible-label: @tr("Check every finished file for viruses with this program"); }
                            }
                            FormStackRow {
                                enabled: root.virus-scan;
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        text <=> root.virus-program;
                                        enabled: root.virus-scan;
                                        placeholder-text: Theme.native-macos ? "/opt/homebrew/bin/clamscan" : @tr("C:\\Program Files\\Windows Defender\\MpCmdRun.exe");
                                        horizontal-stretch: 1;
                                        accessible-label: @tr("Check every finished file for viruses with this program");
                                    }
                                    Button { text: @tr("Choose…"); enabled: root.virus-scan; clicked => { root.browse("virus"); } }
                                }
                            }
                            FormRow {
                                label: @tr("Command line parameters");
                                enabled: root.virus-scan;
                                LineEdit {
                                    width: 240px;
                                    text <=> root.virus-args;
                                    enabled: root.virus-scan;
                                    placeholder-text: Theme.native-macos ? "--no-summary [File]" : @tr("-Scan -ScanType 3 -File [File]");
                                    accessible-label: @tr("Command line parameters");
                                }
                            }
                        }
                        FormSection {
                            title: @tr("Advanced");
                            FormStackRow {
                                first: true;
                                label: @tr("User-Agent for downloads added by hand");
                                LineEdit { text <=> root.user-agent; accessible-label: @tr("User-Agent for downloads added by hand"); }
                            }
                        }
                    }

                    // ---------------- Connection
                    if root.tab == 4: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("Connection type / speed");
                                ComboBox {
                                    width: 230px;
                                    model: [@tr("Low speed (modem, mobile)"), @tr("Medium speed (DSL)"), @tr("High speed (fiber, cable, LAN)")];
                                    current-index <=> root.connection-type;
                                }
                            }
                            FormRow {
                                label: @tr("Default max. connections number");
                                SpinBox { width: 90px; minimum: 1; maximum: 32; value <=> root.connections; accessible-label: @tr("Default max. connections number"); }
                            }
                            FormRow {
                                label: @tr("Downloads at the same time (0 = no limit)");
                                SpinBox { width: 90px; minimum: 0; maximum: 100; value <=> root.max-active; accessible-label: @tr("Downloads at the same time (0 = no limit)"); }
                            }
                            FormRow {
                                label: @tr("Retries on error");
                                SpinBox { width: 90px; minimum: 0; maximum: 100; value <=> root.retries; accessible-label: @tr("Retries on error"); }
                            }
                        }
                        FormSection {
                            title: @tr("Exceptions: servers with their own number of connections");
                            FormStackRow {
                                first: true;
                                PairList {
                                    height: 112px;
                                    rows: root.server-rows;
                                    current <=> root.server-current;
                                    head-a: @tr("Server");
                                    head-b: @tr("Connections");
                                    width-b: 110px;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit { text <=> root.server-host; placeholder-text: @tr("example.com"); horizontal-stretch: 1; accessible-label: @tr("Server"); }
                                    SpinBox { width: 80px; minimum: 1; maximum: 32; value <=> root.server-conns; accessible-label: @tr("Connections"); }
                                    Button { text: @tr("Add"); enabled: root.server-host != ""; clicked => { root.server-add(); } }
                                    Button { text: @tr("Delete"); enabled: root.server-current >= 0; clicked => { root.server-remove(); } }
                                }
                            }
                        }
                        FormSection {
                            title: @tr("Download limits");
                            footer: root.quota-used;
                            FormRow {
                                first: true;
                                label: @tr("Download no more than");
                                Switch { checked <=> root.quota-on; accessible-label: @tr("Download no more than"); }
                                SpinBox { width: 110px; minimum: 1; maximum: 10000000; value <=> root.quota-mb; enabled: root.quota-on; accessible-label: @tr("MB every"); }
                                Text { text: @tr("MB every"); color: root.quota-on ? Theme.text : Theme.muted; vertical-alignment: center; }
                                SpinBox { width: 80px; minimum: 1; maximum: 720; value <=> root.quota-hours; enabled: root.quota-on; accessible-label: @tr("hours"); }
                                Text { text: @tr("hours"); color: root.quota-on ? Theme.text : Theme.muted; vertical-alignment: center; }
                            }
                        }
                    }

                    // ---------------- Proxy
                    if root.tab == 5: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            footer: @tr("Addresses separated by spaces. SOCKS proxies: use the system settings.");
                            FormStackRow {
                                first: true;
                                Radio { text: @tr("No proxy"); checked: root.proxy-mode == 0; clicked => { root.proxy-mode = 0; } }
                                Radio { text: @tr("Use the system settings (like your browser)"); checked: root.proxy-mode == 1; clicked => { root.proxy-mode = 1; } }
                                Radio { text: @tr("Manual proxy configuration (HTTP / HTTPS)"); checked: root.proxy-mode == 2; clicked => { root.proxy-mode = 2; } }
                            }
                            FormRow {
                                label: @tr("Proxy address");
                                enabled: root.proxy-mode == 2;
                                LineEdit { width: 200px; text <=> root.proxy-host; enabled: root.proxy-mode == 2; placeholder-text: @tr("proxy.example.com"); accessible-label: @tr("Proxy address"); }
                                Text { text: @tr("Port"); color: root.proxy-mode == 2 ? Theme.text : Theme.muted; vertical-alignment: center; }
                                SpinBox { width: 90px; minimum: 1; maximum: 65535; value <=> root.proxy-port; enabled: root.proxy-mode == 2; accessible-label: @tr("Port"); }
                            }
                            FormRow {
                                label: @tr("User name");
                                enabled: root.proxy-mode == 2;
                                LineEdit { width: 240px; text <=> root.proxy-user; enabled: root.proxy-mode == 2; accessible-label: @tr("User name"); }
                            }
                            FormRow {
                                label: @tr("Password");
                                enabled: root.proxy-mode == 2;
                                LineEdit { width: 240px; text <=> root.proxy-password; input-type: InputType.password; enabled: root.proxy-mode == 2; accessible-label: @tr("Password"); }
                            }
                            FormRow {
                                label: @tr("Don't use the proxy for");
                                enabled: root.proxy-mode == 2;
                                LineEdit { width: 240px; text <=> root.proxy-bypass; enabled: root.proxy-mode == 2; placeholder-text: @tr("localhost 127.0.0.1 *.local"); accessible-label: @tr("Don't use the proxy for"); }
                            }
                        }
                    }

                    // ---------------- Site logins
                    if root.tab == 6: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            title: @tr("User names and passwords for sites that ask for them:");
                            footer: Theme.native-macos ? @tr("Passwords are encrypted with a key kept in your login Keychain.") : @tr("Saved in the settings file of your Windows user account.");
                            FormStackRow {
                                first: true;
                                PairList {
                                    height: 150px;
                                    rows: root.login-rows;
                                    current <=> root.login-current;
                                    head-a: @tr("Site / path");
                                    head-b: @tr("User name");
                                    width-b: 180px;
                                    picked(i) => {
                                        root.login-pick(i);
                                    }
                                }
                            }
                            FormRow {
                                label: @tr("Site / path");
                                LineEdit { width: 260px; text <=> root.login-site; placeholder-text: @tr("example.com/members"); accessible-label: @tr("Site / path"); }
                            }
                            FormRow {
                                label: @tr("User name");
                                LineEdit { width: 260px; text <=> root.login-user; accessible-label: @tr("User name"); }
                            }
                            FormRow {
                                label: @tr("Password");
                                LineEdit { width: 260px; text <=> root.login-password; input-type: InputType.password; accessible-label: @tr("Password"); }
                            }
                            FormStackRow {
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    Button { text: @tr("Remove"); enabled: root.login-current >= 0; clicked => { root.login-remove(); } }
                                    Button { text: @tr("Add / Update"); enabled: root.login-site != ""; clicked => { root.login-add(); } }
                                }
                            }
                        }
                    }

                    // ---------------- Sounds
                    if root.tab == 7: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            footer: @tr(".wav files. Empty = no sound for that event.");
                            FormRow {
                                first: true;
                                label: @tr("Play sounds");
                                Switch { checked <=> root.sounds-on; accessible-label: @tr("Play sounds"); }
                            }
                            SoundRow { label: @tr("Download complete"); path <=> root.sound-complete; enabled: root.sounds-on; browse => { root.browse("sound:complete"); } play => { root.play("complete"); } }
                            SoundRow { label: @tr("Download failed"); path <=> root.sound-failed; enabled: root.sounds-on; browse => { root.browse("sound:failed"); } play => { root.play("failed"); } }
                            SoundRow { label: @tr("Queue started"); path <=> root.sound-qstart; enabled: root.sounds-on; browse => { root.browse("sound:qstart"); } play => { root.play("qstart"); } }
                            SoundRow { label: @tr("Queue finished"); path <=> root.sound-qdone; enabled: root.sounds-on; browse => { root.browse("sound:qdone"); } play => { root.play("qdone"); } }
                        }
                    }

                    // ---------------- Speed limiter
                    if root.tab == 8: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            footer: @tr("Every download can also have its own limit: its progress window > Speed Limiter tab.");
                            FormRow {
                                first: true;
                                label: @tr("Turn the speed limiter on");
                                Switch { checked <=> root.limiter-on; accessible-label: @tr("Turn the speed limiter on"); }
                            }
                            FormRow {
                                label: @tr("Maximum download speed (KB/s)");
                                SpinBox { width: 120px; minimum: 1; maximum: 1000000; value <=> root.speed-limit; accessible-label: @tr("Maximum download speed (KB/s)"); }
                            }
                            FormRow {
                                label: @tr("Always turn on the speed limiter when Mac Downloader starts");
                                Switch { checked <=> root.limiter-startup; accessible-label: @tr("Always turn on the speed limiter when Mac Downloader starts"); }
                            }
                        }
                    }

                    // ---------------- Torrents
                    if root.tab == 10: VerticalLayout {
                        spacing: 18px;
                        FormSection {
                            FormRow {
                                first: true;
                                label: @tr("Keep sharing a finished torrent for (minutes)");
                                hint: @tr("0 = stop as soon as all files are here. Sharing longer helps the others who download the same torrent.");
                                SpinBox { width: 110px; minimum: 0; maximum: 10080; value <=> root.seed-minutes; accessible-label: @tr("Keep sharing a finished torrent for (minutes)"); }
                            }
                            FormRow {
                                label: @tr("Maximum upload speed (KB/s, 0 = no limit)");
                                hint: @tr("While a torrent downloads it also sends pieces to others (that is how torrents work). A limit keeps your internet free for other things.");
                                SpinBox { width: 110px; minimum: 0; maximum: 1000000; value <=> root.torrent-upload; accessible-label: @tr("Maximum upload speed (KB/s, 0 = no limit)"); }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 6px;
                spacing: 10px;
                Text {
                    text: root.message;
                    color: Theme.err;
                    font-size: Theme.footnote-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Button { text: @tr("Save"); primary: true; clicked => { root.save(); } }
            }
        }
    }
    }
}


// ------------------------------------------------------------------ torrents

export component TorrentDialog inherits ThemedWindow {
    header-names-window: true;
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add a torrent");
    preferred-width: 680px;
    preferred-height: 520px;
    min-width: 540px;
    min-height: 400px;
    // a magnet link or the path of a .torrent file
    in-out property <string> source;
    in property <string> name;
    in property <string> info;
    in property <[LinkRow]> files;
    in-out property <string> folder;
    in-out property <bool> start-now: true;
    in property <string> checked-text;
    in property <string> message;
    in property <bool> magnet;
    callback pick-file();
    callback load();
    callback toggle(int);
    callback check-all(bool);
    callback browse();
    callback download();
    callback close-window();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        DialogHeader {
            title: root.name != "" ? root.name : @tr("Add a torrent");
            subtitle: root.name != "" ? root.info : @tr("A magnet link, or a .torrent file:");
            kind: "torrent";
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.source;
                placeholder-text: Theme.native-macos ? "magnet:?xt=urn:btih:…" : @tr("magnet:?xt=urn:btih:…  or  C:\\…\\file.torrent");
                horizontal-stretch: 1;
                accessible-label: @tr("A magnet link, or a .torrent file:");
                accepted(t) => {
                    root.load();
                }
                edited(t) => {
                    root.load();
                }
            }
            Button { text: @tr("Open .torrent file…"); clicked => { root.pick-file(); } }
        }
        ListFrame {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        HeaderCell { text: ""; width: 58px; }
                        HeaderCell { text: @tr("File"); horizontal-stretch: 1; }
                        HeaderCell { text: @tr("Size"); width: 96px; align: TextHorizontalAlignment.right; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.grid; }
                }
                ListView {
                    vertical-stretch: 1;
                    for f[i] in root.files: Rectangle {
                        height: 24px;
                        background: fa.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.fill : transparent;
                        accessible-role: checkbox;
                        accessible-label: f.name;
                        accessible-checkable: true;
                        accessible-checked: f.checked;
                        accessible-action-default => { root.toggle(i); }
                        fa := TouchArea {
                            clicked => {
                                root.toggle(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Rectangle { width: 18px; CheckMark { y: (parent.height - self.height) / 2; checked: f.checked; } }
                            Rectangle { width: 18px; KindTile { kind: f.kind; y: (parent.height - self.height) / 2; width: 16px; height: 16px; } }
                            Cell { text: f.name; horizontal-stretch: 1; }
                            Cell { text: f.ext; width: 86px; color: Theme.muted; horizontal-alignment: right; }
                        }
                    }
                }
            }
            if root.files.length == 0: Text {
                x: 24px;
                y: 26px;
                width: parent.width - 48px;
                height: parent.height - 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                text: root.magnet
                    ? @tr("A magnet link brings its file list from the other computers when it starts: all its files are downloaded.")
                    : @tr("Paste a magnet link or open a .torrent file: what it shares shows up here.");
                color: Theme.muted;
            }
        }
        if root.files.length > 1: HorizontalLayout {
            spacing: 6px;
            Button { text: @tr("Check all"); clicked => { root.check-all(true); } }
            Button { text: @tr("Uncheck all"); clicked => { root.check-all(false); } }
            Rectangle { horizontal-stretch: 1; }
        }
        FieldRow {
            label: @tr("Save to");
            label-width: 60px;
            LineEdit { text <=> root.folder; horizontal-stretch: 1; accessible-label: @tr("Save to"); }
            Button { text: @tr("Choose…"); clicked => { root.browse(); } }
        }
        HorizontalLayout {
            spacing: 10px;
            CheckBox { text: @tr("Start now"); checked <=> root.start-now; }
            Text {
                text: root.message != "" ? root.message : root.checked-text;
                color: root.message != "" ? Theme.err : Theme.muted;
                font-size: Theme.footnote-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button { text: @tr("Close"); clicked => { root.close-window(); } }
            Button { text: @tr("Download"); primary: true; enabled: root.name != ""; clicked => { root.download(); } }
        }
    }
}

// ------------------------------------------------------------------ YouTube playlist

export component PlaylistDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download a playlist");
    preferred-width: 760px;
    preferred-height: 580px;
    min-width: 600px;
    min-height: 440px;
    in-out property <string> url;
    in property <bool> busy;
    in property <string> status;
    in property <string> playlist-title;
    in property <[LinkRow]> entries;
    in-out property <int> quality: 0;
    in-out property <string> folder;
    in-out property <int> parallel: 2;
    in-out property <bool> numbered: true;
    in-out property <bool> start-now: true;
    in property <string> checked-text;
    in property <string> message;
    callback fetch();
    callback toggle(int);
    callback check-all(bool);
    callback browse();
    callback download();
    callback close-window();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        DialogHeader {
            title: root.playlist-title != "" ? root.playlist-title : @tr("Download a playlist");
            subtitle: root.status != "" ? root.status : @tr("Paste the address of a playlist:");
            glyph: "queue";
            tint: Theme.tint("video");
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.url;
                placeholder-text: @tr("https://…/playlist?list=…");
                horizontal-stretch: 1;
                accessible-label: @tr("Paste the address of a playlist:");
                accepted(t) => {
                    root.fetch();
                }
            }
            Button {
                text: root.busy ? @tr("Getting the list…") : @tr("Get videos");
                primary: root.entries.length == 0;
                enabled: !root.busy && root.url != "";
                clicked => {
                    root.fetch();
                }
            }
        }
        ListFrame {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        HeaderCell { text: ""; width: 38px; }
                        HeaderCell { text: "#"; width: 40px; }
                        HeaderCell { text: @tr("Video"); horizontal-stretch: 1; }
                        HeaderCell { text: @tr("Length"); width: 80px; align: TextHorizontalAlignment.right; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.grid; }
                }
                ListView {
                    vertical-stretch: 1;
                    for e[i] in root.entries: Rectangle {
                        height: 24px;
                        background: ea.has-hover ? Theme.hover : Math.mod(i, 2) == 1 ? Theme.fill : transparent;
                        accessible-role: checkbox;
                        accessible-label: e.name;
                        accessible-checkable: true;
                        accessible-checked: e.checked;
                        accessible-action-default => { root.toggle(i); }
                        ea := TouchArea {
                            clicked => {
                                root.toggle(i);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Rectangle { width: 22px; CheckMark { y: (parent.height - self.height) / 2; checked: e.checked; } }
                            Cell { text: e.text; width: 36px; color: Theme.muted; font-size: Theme.footnote-size; }
                            Cell { text: e.name; horizontal-stretch: 1; }
                            Cell { text: e.ext; width: 70px; color: Theme.muted; horizontal-alignment: right; font-size: Theme.footnote-size; }
                        }
                    }
                }
            }
            if root.entries.length == 0: Text {
                y: 26px;
                width: parent.width;
                height: parent.height - 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.busy ? @tr("Getting the videos of the playlist…") : @tr("The videos of the playlist show up here.");
                color: Theme.muted;
            }
        }
        if root.entries.length > 1: HorizontalLayout {
            spacing: 6px;
            Button { text: @tr("Check all"); clicked => { root.check-all(true); } }
            Button { text: @tr("Uncheck all"); clicked => { root.check-all(false); } }
            Rectangle { horizontal-stretch: 1; }
        }
        GridLayout {
            spacing-horizontal: 10px;
            spacing-vertical: 8px;
            Row {
                Text { text: @tr("Quality"); vertical-alignment: center; horizontal-alignment: right; color: Theme.text; }
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        width: 220px;
                        model: [@tr("Best quality (MP4)"), @tr("2160p 4K"), @tr("1440p 2K"), @tr("1080p Full HD"), @tr("720p HD"), @tr("480p SD"), @tr("360p SD"), @tr("Audio only (M4A)"), @tr("Audio MP3")];
                        current-index <=> root.quality;
                    }
                    Text { text: @tr("Files at the same time"); vertical-alignment: center; color: Theme.text; }
                    SpinBox { width: 80px; minimum: 1; maximum: 8; value <=> root.parallel; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            Row {
                Text { text: @tr("Save to"); vertical-alignment: center; horizontal-alignment: right; color: Theme.text; }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit { text <=> root.folder; horizontal-stretch: 1; accessible-label: @tr("Save to"); }
                    Button { text: @tr("Choose…"); clicked => { root.browse(); } }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            CheckBox { text: @tr("Number the files"); checked <=> root.numbered; }
            CheckBox { text: @tr("Start now"); checked <=> root.start-now; }
            Text {
                text: root.message != "" ? root.message : root.checked-text;
                color: root.message != "" ? Theme.err : Theme.muted;
                font-size: Theme.footnote-size;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button { text: @tr("Close"); clicked => { root.close-window(); } }
            Button { text: @tr("Download"); primary: root.entries.length > 0; enabled: root.entries.length > 0; clicked => { root.download(); } }
        }
    }
}

// ------------------------------------------------------------------ add the extension to a browser

export struct BrowserRow {
    name: string,
    // accent color of its card
    tint: color,
    installed: bool,
    // "Add from the store" / "Add (developer mode)"
    action: string,
}

export component BrowserDialog inherits ThemedWindow {
    header-names-window: true;
    // Native window controls stay available while setup opens the browser.
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Browser Extension Setup");
    preferred-width: 600px;
    preferred-height: 500px;
    min-width: 500px;
    min-height: 380px;

    in property <[string]> browser-names;
    in-out property <int> current-browser: 0;
    in property <bool> has-browsers;
    in property <bool> prepared;
    in property <bool> connected;
    in property <string> connection-title;
    in property <string> connection-detail;
    in property <string> setup-title;
    in property <string> setup-detail;
    in property <string> first-title;
    in property <string> first-detail;
    in property <string> second-title;
    in property <string> second-detail;
    in property <string> notice;
    in property <string> folder;
    in property <string> setup-action;
    in property <string> fallback;

    callback select-browser(int);
    callback start-setup();
    callback reopen-browser();
    callback open-folder();
    callback copy-folder();
    callback check-connection();
    callback close-window();

    property <bool> show-trouble;
    changed current-browser => {
        root.show-trouble = false;
    }

    VerticalLayout {
        spacing: 0px;
        setup-scroll := ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: setup-body.preferred-height;
            setup-body := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 20px;
                spacing: 18px;
                alignment: start;
                HorizontalLayout {
                    spacing: 14px;
                    BrandMark { width: 48px; height: 48px; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.setup-title;
                            color: Theme.text;
                            font-size: Theme.title2-size;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.setup-detail;
                            color: Theme.muted;
                            font-size: Theme.body-size;
                            wrap: word-wrap;
                        }
                    }
                }

                // Connection status first: it answers "does it work?"
                Rectangle {
                    background: root.connected ? Theme.ok.transparentize(0.88) : Theme.panel;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: root.connected ? Theme.ok.transparentize(0.6) : Theme.grid;
                    accessible-role: groupbox;
                    accessible-label: root.connection-title;
                    accessible-description: root.connection-detail;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        Rectangle {
                            width: 28px;
                            Rectangle {
                                y: 0px;
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.connected ? Theme.ok : Theme.fill;
                                Glyph { x: 6px; y: 6px; width: 16px; height: 16px; kind: root.connected ? "check" : "clock"; tint: root.connected ? Theme.on-accent : Theme.muted; }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            Text {
                                text: root.connection-title;
                                color: Theme.text;
                                font-size: Theme.body-size;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.connection-detail;
                                color: Theme.muted;
                                font-size: Theme.footnote-size;
                                wrap: word-wrap;
                            }
                        }
                        if root.prepared: VerticalLayout {
                            alignment: center;
                            Button { text: @tr("Check Connection"); clicked => { root.check-connection(); } }
                        }
                    }
                }

                FormSection {
                    FormRow {
                        first: true;
                        label: @tr("Browser");
                        ComboBox {
                            width: 200px;
                            model: root.browser-names;
                            current-index <=> root.current-browser;
                            enabled: root.has-browsers;
                            accessible-label: @tr("Browser");
                            selected(v) => {
                                root.select-browser(root.current-browser);
                            }
                        }
                        Button {
                            text: root.setup-action;
                            enabled: root.has-browsers;
                            primary: !root.connected;
                            clicked => {
                                root.start-setup();
                            }
                        }
                    }
                }

                if root.prepared && !root.connected: FormSection {
                    for step[i] in [
                        { title: root.first-title, detail: root.first-detail },
                        { title: root.second-title, detail: root.second-detail }
                    ]: Rectangle {
                        if i > 0: Rectangle { x: 52px; y: 0px; width: parent.width - 52px; height: 1px; background: Theme.grid; }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;
                            Rectangle {
                                width: 24px;
                                Rectangle {
                                    y: 0px;
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: Theme.accent;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: i + 1;
                                        color: Theme.on-accent;
                                        font-size: Theme.footnote-size;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Text {
                                    text: step.title;
                                    color: Theme.text;
                                    font-size: Theme.body-size;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: step.detail;
                                    color: Theme.muted;
                                    font-size: Theme.footnote-size;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                if root.prepared: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: @tr("Open Browser Again…"); enabled: root.has-browsers; clicked => { root.reopen-browser(); } }
                    Button { text: Theme.native-macos ? @tr("Show in Finder") : @tr("Show Folder…"); enabled: root.folder != ""; clicked => { root.open-folder(); } }
                }

                if root.notice != "": Notice { text: root.notice; tone: "info"; }

                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        Disclosure {
                            text: @tr("Having Trouble?");
                            expanded <=> root.show-trouble;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.show-trouble: VerticalLayout {
                        spacing: 10px;
                        padding-left: 22px;
                        Text {
                            text: root.fallback;
                            color: Theme.text;
                            font-size: Theme.body-size;
                            wrap: word-wrap;
                        }
                        if root.folder != "": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: @tr("Extension Folder");
                                color: Theme.muted;
                                font-size: Theme.footnote-size;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text: root.folder;
                                    read-only: true;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Extension Folder");
                                }
                                Button { text: @tr("Copy Folder Path"); clicked => { root.copy-folder(); } }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: end;
            Button {
                text: root.connected ? @tr("Done") : @tr("Close");
                primary: root.connected;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ About

export component AboutDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("About Mac Downloader");
    preferred-width: 380px;
    in property <string> version;
    callback open-link(string);
    callback close-window();
    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icon.png");
                width: 80px;
                height: 80px;
                accessible-role: image;
                accessible-label: "Mac Downloader";
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: "Mac Downloader";
            horizontal-alignment: center;
            font-size: Theme.title2-size;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: @tr("Version {}", root.version);
            horizontal-alignment: center;
            font-size: Theme.footnote-size;
            color: Theme.muted;
        }
        Text {
            text: @tr("Coded by Ahmed Ezzat");
            horizontal-alignment: center;
            font-size: Theme.footnote-size;
            color: Theme.muted;
        }
        Rectangle { height: 6px; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Button {
                text: "YouTube";
                clicked => {
                    root.open-link("https://www.youtube.com/@Ezoo-Tech");
                }
            }
            Button {
                text: "Facebook";
                clicked => {
                    root.open-link("https://www.facebook.com/profile.php?id=61558130707674");
                }
            }
            Button {
                text: @tr("Support with PayPal");
                clicked => {
                    root.open-link("https://www.paypal.me/ibrahimalmaroof");
                }
            }
        }
        Rectangle { height: 8px; }
        AboutSlint {
            preferred-height: 80px;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}


// After an update: what is new, right to left in Arabic.
export component WhatsNewDialog inherits ThemedWindow {
    header-names-window: true;
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("What's new in Mac Downloader");
    preferred-width: 520px;
    preferred-height: 600px;
    min-width: 440px;
    min-height: 420px;
    in property <string> heading;
    in property <[string]> items;
    in property <bool> rtl;
    callback open-link(string);
    callback close-window();
    property <TextHorizontalAlignment> side: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    property <[{glyph: string, kind: string}]> marks: [
        { glyph: "sparkles", kind: "doc" },
        { glyph: "progress", kind: "torrent" },
        { glyph: "plus", kind: "archive" },
        { glyph: "settings", kind: "general" },
        { glyph: "appearance", kind: "exe" },
        { glyph: "puzzle", kind: "audio" },
    ];
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) { root.close-window(); return accept; }
            reject
        }
    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 30px;
        padding-bottom: 24px;
        spacing: 22px;
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("icon.png");
                    width: 76px;
                    height: 76px;
                    accessible-role: image;
                    accessible-label: "Mac Downloader";
                }
            }
            Rectangle { height: 4px; }
            Text {
                text: @tr("What's New");
                horizontal-alignment: center;
                font-size: 26px * Theme.font-scale;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: root.heading;
                horizontal-alignment: center;
                font-size: Theme.body-size;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: features.preferred-height;
            features := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                alignment: start;
                spacing: 18px;
                padding-right: 8px;
                for line[i] in root.items: HorizontalLayout {
                    spacing: 16px;
                    if !root.rtl: Rectangle {
                        width: 38px;
                        Rectangle {
                            y: 0px;
                            width: 38px;
                            height: 38px;
                            border-radius: 11px;
                            background: Theme.tint(root.marks[Math.mod(i, root.marks.length)].kind);
                            Glyph { x: 10px; y: 10px; width: 18px; height: 18px; kind: root.marks[Math.mod(i, root.marks.length)].glyph; tint: Theme.on-accent; }
                        }
                    }
                    Text {
                        text: line;
                        color: Theme.text;
                        font-size: Theme.body-size;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-alignment: root.side;
                        horizontal-stretch: 1;
                    }
                    if root.rtl: Rectangle {
                        width: 38px;
                        Rectangle {
                            y: 0px;
                            width: 38px;
                            height: 38px;
                            border-radius: 11px;
                            background: Theme.tint(root.marks[Math.mod(i, root.marks.length)].kind);
                            Glyph { x: 10px; y: 10px; width: 18px; height: 18px; kind: root.marks[Math.mod(i, root.marks.length)].glyph; tint: Theme.on-accent; }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Button {
                    min-width: 240px;
                    text: @tr("Continue");
                    primary: true;
                    clicked => { root.close-window(); }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: @tr("Mac Downloader is free and has no ads.");
                    color: Theme.muted;
                    font-size: Theme.footnote-size;
                    vertical-alignment: center;
                }
                support := Rectangle {
                    min-width: support-label.preferred-width + 8px;
                    height: support-label.preferred-height + 4px;
                    accessible-role: button;
                    accessible-label: @tr("Support with PayPal");
                    accessible-action-default => { root.open-link("https://www.paypal.me/ibrahimalmaroof"); }
                    support-label := Text {
                        x: 4px;
                        text: @tr("Support with PayPal");
                        color: Theme.accent-text;
                        font-size: Theme.footnote-size;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-link("https://www.paypal.me/ibrahimalmaroof"); }
                    }
                }
            }
        }
    }
    }
}

// Help > Check for updates: looks for a new version, says when
// this one is the newest, otherwise downloads the new one right here and
// installs it in front of the user.
export component UpdateDialog inherits ThemedWindow {
    header-names-window: true;
    // set for a moment so the window comes in front
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Check for updates");
    preferred-width: 440px;
    // 0 checking, 1 newest already, 2 downloading, 3 installing, 4 problem
    in property <int> state;
    in property <string> heading;
    in property <string> detail;
    // 0..1 while downloading (-1 = size unknown)
    in property <float> progress: -1;
    callback close-window();
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        DialogHeader {
            title: root.heading;
            subtitle: root.detail;
            glyph: root.state == 1 ? "check" : root.state == 4 ? "warn" : "down";
            tint: root.state == 1 ? Theme.ok : root.state == 4 ? Theme.err : Theme.accent;
        }
        if root.state == 0 || root.state == 2 || root.state == 3: Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.bar-bg;
            clip: true;
            accessible-role: progress-indicator;
            accessible-label: root.heading;
            // known size: how far it is; otherwise a moving piece (still when Reduce Motion is on)
            if root.state == 2 && root.progress >= 0: Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: Theme.reduce-motion ? 0ms : 150ms; }
            }
            if !(root.state == 2 && root.progress >= 0): Rectangle {
                width: parent.width * 0.3;
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent;
                x: Theme.reduce-motion ? parent.width * 0.35 : mod(animation-tick() / 1ms, 1600) / 1600 * (parent.width * 1.3) - parent.width * 0.3;
            }
        }
        ButtonRow {
            Button {
                text: root.state == 2 || root.state == 3 ? @tr("Hide") : @tr("Close");
                primary: root.state == 1 || root.state == 4;
                enabled: root.state != 3;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
